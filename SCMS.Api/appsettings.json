{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=scms.local.db",
    "PostgreSqlConnection": "Host=localhost;Port=5433;Database=SCMS_db;Username=postgres;Password=admin;"
  },
  "Database": {
    "Provider": "PostgreSql",
    "EnsurePermissionsSeeded": false,
    "EnsureCreated": false,
    "SeedDemoUsers": false
  },
  "Cloudinary": {
    "CloudName": "dynwrqygo"
  },
  "Jwt": {
    "Issuer": "SCMS.Api",
    "Audience": "SCMS.Web",
    "SigningKey": "SCMS local development signing key 2026 - replace with a secret",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Gemini": {
    "//": "Do not put real keys here. Use: dotnet user-secrets set \"Gemini:ApiKeys:0\" \"<key>\"",
    "Model": "gemini-3.5-flash-lite",
    "ApiKeys": []
  },
  "Clinic": {
    "TimeZone": "Asia/Yangon"
  },
  "AllowedHosts": "*"
}
